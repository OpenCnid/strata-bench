    "actual_active_s",
    "source_export",
    "campaign_id",
    "agent_id",
    "system_digest",
    "model_identity",
    "arm",
    "initial_files",
    "experienced_files",
    "experienced_skills",
    "session",
    "runtime_cache",
    "dispatch_authorized",
    "campaign_feedback_allowed"
  ],
  "title": "NativeProbeArtifactProjection",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
