    "source_export": {
      "pattern": "^cas:sha256:[0-9a-f]{64}$",
      "title": "Source Export",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "agent_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Agent Id",
      "type": "string"
    },
    "system_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "System Digest",
      "type": "string"
    },
    "model_identity": {
      "title": "Model Identity",
      "type": "string"
    },
    "arm": {
      "enum": [
        "full",
        "frozen-persistence",
        "frozen-skills",
