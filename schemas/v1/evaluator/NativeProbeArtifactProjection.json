      },
      "title": "Experienced Skills",
      "type": "object"
    },
    "session": {
      "title": "Session",
      "type": "null"
    },
    "runtime_cache": {
      "title": "Runtime Cache",
      "type": "null"
    },
    "dispatch_authorized": {
      "const": false,
