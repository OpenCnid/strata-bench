{
  "$defs": {
    "ProbeSkill": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Revision Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "procedure",
            "executable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "files": {
          "additionalProperties": {
            "pattern": "^cas:sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "revision_id",
        "kind",
        "files"
      ],
      "title": "ProbeSkill",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "strata/NativeProbeArtifactProjection/1",
      "title": "Schema",
      "type": "string"
    },
    "policy": {
      "const": "native-checkpoint-probe-artifact-projection/1",
      "title": "Policy",
      "type": "string"
    },
    "is_example": {
      "title": "Is Example",
      "type": "boolean"
