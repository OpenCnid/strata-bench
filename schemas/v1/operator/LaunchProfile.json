      "title": "Is Example",
      "type": "boolean"
    },
    "client": {
      "$ref": "#/$defs/LaunchCommand"
    },
    "server": {
      "$ref": "#/$defs/LaunchCommand"
    }
  },
  "required": [
    "schema",
    "is_example",
    "client",
    "server"
  ],
  "title": "LaunchProfile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
