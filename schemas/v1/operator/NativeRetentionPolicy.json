{
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "strata/NativeRetentionPolicy/1",
      "title": "Schema",
      "type": "string"
    },
    "is_example": {
      "title": "Is Example",
      "type": "boolean"
    },
    "policy": {
      "const": "native-preregistered-retention-checkpoint/1",
      "title": "Policy",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "agent_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Agent Id",
      "type": "string"
    },
    "system_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "System Digest",
      "type": "string"
    },
    "arm": {
      "enum": [
        "full",
        "frozen-persistence",
        "frozen-skills",
        "no-self-play"
      ],
      "title": "Arm",
      "type": "string"
    },
    "initial_artifacts": {
      "pattern": "^cas:sha256:[0-9a-f]{64}$",
      "title": "Initial Artifacts",
      "type": "string"
    },
    "resume_mode": {
      "const": "fresh_handoff",
      "title": "Resume Mode",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "is_example",
    "policy",
    "campaign_id",
    "agent_id",
    "system_digest",
    "arm",
    "initial_artifacts",
    "resume_mode"
  ],
  "title": "NativeRetentionPolicy",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
