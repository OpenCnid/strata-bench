{
  "$defs": {
    "ActionBatch": {
      "additionalProperties": false,
      "properties": {
        "is_example": {
          "title": "Is Example",
          "type": "boolean"
        },
        "campaign_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "recorded_at": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
          "title": "Recorded At",
          "type": "string"
        },
        "schema": {
          "const": "mcbench/ActionBatch/1",
          "title": "Schema",
          "type": "string"
        },
        "agent_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Agent Id",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Lease Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Observation Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "structured",
            "input"
          ],
          "title": "Mode",
          "type": "string"
        },
        "expected_state_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected State Revision",
          "type": "integer"
        },
        "capability_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Capability Digest",
          "type": "string"
        },
        "control_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Control Revision",
          "type": "integer"
        },
        "keymap_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keymap Digest"
        },
        "deadline_at": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
          "title": "Deadline At",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "action": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "attack": "#/$defs/EntityAction",
                  "chat": "#/$defs/Chat",
                  "click_slot": "#/$defs/ClickSlot",
                  "close_window": "#/$defs/CloseWindow",
                  "craft": "#/$defs/Craft",
                  "dig": "#/$defs/BlockAction",
                  "equip": "#/$defs/Equip",
                  "interact_block": "#/$defs/BlockAction",
                  "interact_entity": "#/$defs/EntityAction",
                  "look_at": "#/$defs/LookAt",
                  "move_to": "#/$defs/MoveTo",
                  "place": "#/$defs/Place",
                  "quest_menu": "#/$defs/QuestMenuAction",
                  "quest_navigate": "#/$defs/QuestNavigate",
                  "quest_reward": "#/$defs/QuestReward",
                  "quest_task": "#/$defs/QuestTask",
                  "quest_ui": "#/$defs/QuestUi",
                  "recipe_navigate": "#/$defs/RecipeNavigate",
                  "use_item": "#/$defs/UseItem"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/MoveTo"
                },
                {
                  "$ref": "#/$defs/LookAt"
                },
                {
                  "$ref": "#/$defs/BlockAction"
                },
                {
                  "$ref": "#/$defs/Place"
                },
                {
                  "$ref": "#/$defs/EntityAction"
                },
                {
                  "$ref": "#/$defs/Equip"
                },
                {
                  "$ref": "#/$defs/UseItem"
                },
                {
                  "$ref": "#/$defs/ClickSlot"
                },
                {
                  "$ref": "#/$defs/CloseWindow"
                },
                {
                  "$ref": "#/$defs/Craft"
                },
                {
                  "$ref": "#/$defs/QuestUi"
                },
                {
                  "$ref": "#/$defs/QuestNavigate"
                },
                {
                  "$ref": "#/$defs/RecipeNavigate"
                },
                {
                  "$ref": "#/$defs/QuestTask"
                },
                {
                  "$ref": "#/$defs/QuestReward"
                },
                {
                  "$ref": "#/$defs/QuestMenuAction"
                },
                {
                  "$ref": "#/$defs/Chat"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "key_down": "#/$defs/KeyEvent",
                "key_up": "#/$defs/KeyEvent",
                "pointer_absolute": "#/$defs/PointerAbsolute",
                "pointer_relative": "#/$defs/PointerDelta",
                "scroll": "#/$defs/PointerDelta",
                "text": "#/$defs/TextEvent",
                "wait": "#/$defs/WaitEvent"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KeyEvent"
              },
              {
                "$ref": "#/$defs/PointerAbsolute"
              },
              {
                "$ref": "#/$defs/PointerDelta"
              },
              {
                "$ref": "#/$defs/TextEvent"
              },
              {
                "$ref": "#/$defs/WaitEvent"
              }
            ]
          },
          "maxItems": 64,
          "title": "Events",
          "type": "array"
        },
        "release_at_end": {
          "const": true,
          "title": "Release At End",
          "type": "boolean"
        }
      },
      "required": [
        "is_example",
        "campaign_id",
        "epoch",
        "seq",
        "recorded_at",
        "schema",
        "agent_id",
        "lease_id",
        "request_id",
        "observation_id",
        "mode",
        "expected_state_revision",
        "capability_digest",
        "control_revision",
        "keymap_digest",
        "deadline_at",
        "duration_ms",
        "action",
        "events",
        "release_at_end"
      ],
      "title": "ActionBatch",
      "type": "object"
    },
